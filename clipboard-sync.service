[Unit]
Description=Clipboard Sync Daemon (Desktop <-> Phone)
After=graphical-session.target network-online.target tailscaled.service
Wants=graphical-session.target network-online.target

[Service]
Type=simple
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR
ExecStart=%h/clipboard-sync/clipsyncd-wrapper.sh
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
WantedBy=graphical-session.target
