<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for HTTP / SSE -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ignore battery optimization to prevent Vivo/FuntouchOS from killing background tasks -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        "Draw over other apps" — used to briefly show a 1×1 transparent overlay
        when a clipboard change is detected in the background. The overlay gains
        window focus, which grants clipboard read access (Android 10+ restriction).
        The overlay is removed in <400ms and is invisible (alpha=0, 1×1 pixel).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keep the CPU awake during sync (partial wake lock) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service: base permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Android 14+ requires the exact foreground-service type permission.
        We use "specialUse" because clipboard sync does not map cleanly to
        any of the standard types (camera, microphone, location, dataSync, etc.).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Post notifications (Android 13 / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Receive connectivity broadcasts so we can reconnect on network change -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        File sharing: read shared files from other apps (photos, documents, etc.)
        Android 13+ uses granular media permissions; older versions use READ_EXTERNAL_STORAGE.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- All files access permission for direct folder watch on public Download directory -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />


    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.EarthQuack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ProfileEditorActivity"
            android:exported="false"
            android:label="@string/profile_editor_add_title" />

        <!--
            Share-sheet target — appears as "earthQuack" in the Android share sheet.
            Accepts any single file or multiple files from any app.
            The activity is transparent (Theme.Translucent.NoTitleBar) and finishes
            immediately after starting FileTransferService.
        -->
        <!--
            Sub-screens of Settings. Separate activities rather than fragments
            in MainActivity because they are pushed detail screens: they get a
            back arrow and deliberately no bottom navigation, so a tab bar would
            imply they are peers of the four tabs.
        -->
        <!--
            Adding an rclone remote, in two steps: pick a backend from
            config/providers, then fill in the form rclone declares for it.
            Separate activities because this is a pushed flow with its own back
            stack, not a tab.
        -->
        <activity
            android:name=".ui.AddRemoteActivity"
            android:exported="false"
            android:label="@string/add_remote_title" />
        <activity
            android:name=".ui.RemoteFormActivity"
            android:exported="false"
            android:label="@string/add_remote_title" />

        <!--
            Downloaded-files cache: how long to keep them, and a way to empty
            the cache now. Separate from the Files screen because it is a
            storage policy, not a browsing control.
        -->
        <activity
            android:name=".ui.sub.FilesCacheActivity"
            android:exported="false"
            android:label="@string/files_cache_title" />

        <activity
            android:name=".ui.sub.SecurityActivity"
            android:exported="false"
            android:label="@string/security_title" />
        <activity
            android:name=".ui.sub.BatteryActivity"
            android:exported="false"
            android:label="@string/settings_battery" />
        <activity
            android:name=".ui.sub.PermissionsActivity"
            android:exported="false"
            android:label="@string/settings_permissions" />

        <!--
            Handle the intent filter below.

            Android 12+ requires android:exported on every component with an
            intent-filter; this one is explicit rather than inherited.
        -->
        <activity
            android:name=".FileShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="earthQuack">
            <!-- Single file share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Multiple files share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            The Files screen. Its own activity rather than a tab, because it
            has a back arrow and no bottom bar in the mockup. Backed by the
            embedded rclone (operations/list) rather than by java.io.File, so
            it can browse a configured remote as well as internal storage.
        -->
        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:label="@string/files_title" />

        <!--
            Shows a downloaded file in-app: a photo, a clip, a track or a PDF.

            Not exported: it is only ever started from this app, with a path
            into this app's own cache.
        -->
        <activity
            android:name=".ui.FilePreviewActivity"
            android:exported="false"
            android:label="@string/files_preview_title" />

        <!--
            Serves downloaded remote files to viewer apps.

            Required because the download lands in cache, and handing a
            viewer a file:// URI there throws FileUriExposedException on
            API 24+. The grant is per-URI and read-only, and the configured
            root is the single "opened/" subdirectory (res/xml/file_paths.xml)
            rather than the whole cache, so a viewer can never reach
            rclone.conf or another app's data through this provider.

            The authority is derived from the application id, so a debug build
            and a release build installed together do not collide.
            No existing provider was registered in this manifest, so nothing is
            being replaced by this entry.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".EarthQuackService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <!--
                Required for specialUse: describe why none of the standard types apply.
                Clipboard sync requires continuous SSE connection (not dataSync which
                implies user-initiated file transfers) and reads the Android clipboard
                which has no dedicated foreground-service type.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Clipboard synchronisation: maintains a persistent SSE
                    connection to receive clipboard updates from the paired desktop and
                    monitors the Android clipboard to push changes to the desktop.
                    No other foreground-service type covers clipboard access." />
        </service>

        <!-- File transfer service: handles uploads and downloads with progress notifications -->
        <service
            android:name=".FileTransferService"
            android:exported="false" />

        <!--
            Embedded SFTP server. Serves one configured directory over SSH to
            clients on the tailnet (Arch rclone, OpenSSH sftp, ...).
            Foreground so a transfer is not killed mid-file; the notification is
            also the only honest indicator that a port is listening.
        -->
        <service
            android:name=".sftp.SftpServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="SFTP file server: accepts SSH/SFTP connections from
                    configured tailnet clients to serve one chosen directory. No
                    standard foreground-service type covers an inbound file
                    server that must keep running while the screen is off." />
        </service>

        <!-- Input Method Service for reliable background clipboard monitoring -->
        <service
            android:name=".ClipboardImeService"
            android:label="earthQuack Service"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Quick Settings Tile for toggling sync ON/OFF -->
        <service
            android:name=".SyncTileService"
            android:icon="@drawable/ic_launcher"
            android:label="earthQuack"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Handles the Stop action tap from the persistent notification -->
        <receiver
            android:name=".StopReceiver"
            android:exported="false" />


    </application>
</manifest>

