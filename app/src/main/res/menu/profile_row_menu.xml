<?xml version="1.0" encoding="utf-8"?>
<!-- Context menu for a profile row: terminal and files are deliberately
     absent, they arrive in a later screen. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Edit -->
    <item
        android:id="@+id/menu_edit"
        android:title="@string/profiles_edit"
        android:icon="@drawable/ic_eq_open_new" />

    <!-- Files -->
    <item
        android:id="@+id/menu_files"
        android:title="@string/profiles_files"
        android:icon="@drawable/ic_eq_folder" />

    <!-- Test: connect and authenticate without changing anything. -->
    <item
        android:id="@+id/menu_test"
        android:title="@string/profiles_test"
        android:icon="@drawable/ic_eq_refresh" />

    <!-- Delete -->
    <item
        android:id="@+id/menu_delete"
        android:title="@string/profiles_delete"
        android:icon="@drawable/ic_eq_delete" />

</menu>
