<?xml version="1.0" encoding="utf-8"?>
<!-- Progress track. Level drives the <clip> width, so setting progress on the
     ProgressBar fills it. No rounded caps: a 1px radius on a 8dp-tall bar
     reads as a rendering artefact, not a design choice. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1E242D"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/eq_primary"/>
                <corners android:radius="3dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
