<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab is the primary blue; unselected stay muted. Muted rather
     than a second grey so unselected tabs recede instead of competing with
     the content above them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/eq_primary" android:state_checked="true"/>
    <item android:color="@color/eq_text_muted"/>
</selector>
