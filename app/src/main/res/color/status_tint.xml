<?xml version="1.0" encoding="utf-8"?>
<!-- Status text/dot colour by state. Applied together with a text label, never
     alone — see styles.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/eq_success" android:state_selected="true"/>
    <item android:color="@color/eq_error" android:state_activated="true"/>
    <item android:color="@color/eq_text_muted"/>
</selector>
