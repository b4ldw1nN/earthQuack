<?xml version="1.0" encoding="utf-8"?>
<!--
    SFTP browser: current path, one upload action, and the listing.

    Connecting, listing and failing are one state line rather than three
    screens: a browser that replaces its whole body with a spinner and then
    with an error scrolls the user back to the top for nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/eq_gutter"
    android:paddingEnd="@dimen/eq_gutter"
    android:paddingTop="@dimen/eq_gap_sm"
    android:paddingBottom="@dimen/eq_gap_xl">

    <!-- Where we are. -->
    <TextView
        android:id="@+id/textPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="start"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Eq.Meta"
        tools:text="/home/zoro" />

    <!-- Listing. Hidden while a retry prompt is the only useful content. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listEntries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/eq_gap_sm"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none"
        tools:listitem="@layout/item_sftp_entry" />

    <TextView
        android:id="@+id/textState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="@dimen/eq_gap_md"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
        android:visibility="gone"
        tools:text="Connecting…"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.Eq.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/eq_gap_sm"
        android:text="@string/sftp_browser_retry"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpload"
        style="@style/Widget.Eq.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eq_gap_sm"
        android:text="@string/sftp_browser_upload"
        tools:visibility="gone" />

</LinearLayout>
