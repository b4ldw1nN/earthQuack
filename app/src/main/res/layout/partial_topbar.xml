<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact app bar, shared by every screen.

    Three optional slots so one layout serves a tab title ("Storage" + subtitle)
    and a pushed sub-screen (back arrow + "Connections" + subtitle), without
    either layout needing its own bar:

      btnBack     — shown on pushed sub-screens only
      title       — always present
      subtitle    — optional; hidden when empty
      btnAction   — optional trailing action (overflow, search, settings gear)

    Height is fixed at 56dp rather than wrap_content so the content area below
    does not resize when a subtitle appears or disappears.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/eq_topbar_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/eq_gap_sm"
    android:paddingEnd="@dimen/eq_gap_sm"
    android:background="@color/eq_background">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_eq_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/eq_text_secondary"
        android:contentDescription="@string/action_back"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_gap_md"
        android:paddingEnd="@dimen/eq_gap_sm">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.Title"
            android:maxLines="1"
            android:ellipsize="end"
            tools:ignore="UnusedAttribute" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.Subtitle"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_eq_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/eq_text_secondary"
        android:contentDescription="@string/action_more"
        android:visibility="gone" />

</LinearLayout>
