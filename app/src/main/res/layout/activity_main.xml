<?xml version="1.0" encoding="utf-8"?>
<!--
    Shell for all four tabs.

    The fragment container fills the space between the app bar and the bottom
    navigation; the bar itself sits outside the container so that pushing a
    sub-screen (Connections, SFTP, Clipboard) keeps it visible, matching the
    mockup where those screens show both a back arrow and the bottom bar.

    Files and Security are separate activities instead, because the mockup
    gives them a back arrow and no bottom navigation — they are deeper than a
    tab, and giving them a tab bar would imply they can be swiped to.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background">

    <LinearLayout
        style="@style/Widget.Eq.Screen">

        <!-- App bar. Compact: title + optional subtitle, no elevation. -->
        <include
            android:id="@+id/appbar"
            layout="@layout/partial_topbar"/>

        <!-- Two stacked containers: tabs live in tab_container and are
             show/hidden; a pushed sub-screen is displayed in subscreen_container.
             Using FragmentContainerView ensures proper FragmentManager transactions,
             z-ordering, and layout passes. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/tab_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Pushed sub-screens land here, above the tabs. -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/subscreen_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/eq_background"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Hairline above the bar. Without it the bar's background change is
             the only boundary, which is too subtle on this palette. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/eq_divider"
            android:background="@color/eq_border" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/eq_nav_h"
            android:background="@color/eq_nav_bar"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemIconSize="22dp"
            app:itemActiveIndicatorStyle="@style/Widget.Eq.NavIndicator"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:itemRippleColor="@color/eq_ripple"
            app:menu="@menu/bottom_nav" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
