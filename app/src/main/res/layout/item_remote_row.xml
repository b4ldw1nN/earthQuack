<?xml version="1.0" encoding="utf-8"?>
<!--
    One configured rclone remote.

    The icon is a tinted tile rather than a provider logo: rclone has ~40
    backends and drawing real logos for all of them is not maintainable, and a
    wrong logo is worse than a neutral one. The remote's name is always text, so
    identity never depends on the icon.

    Status is text, never colour alone — "Connected" / "Unavailable" etc.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Eq.RowIcon"
    android:id="@+id/remoteRow">

    <FrameLayout
        android:layout_width="@dimen/eq_icon_tile"
        android:layout_height="@dimen/eq_icon_tile"
        android:background="@drawable/bg_eq_pill">

        <ImageView
            android:id="@+id/remoteIcon"
            android:layout_width="@dimen/eq_icon_sm"
            android:layout_height="@dimen/eq_icon_sm"
            android:layout_gravity="center"
            android:src="@drawable/ic_eq_cloud"
            app:tint="@color/eq_provider_sftp"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/eq_gap_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/remoteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.RowTitle"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="google-drive" />

        <TextView
            android:id="@+id/remoteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="sftp · Connected" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/remoteMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_eq_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/eq_text_muted"
        android:contentDescription="@string/action_more" />

</LinearLayout>
