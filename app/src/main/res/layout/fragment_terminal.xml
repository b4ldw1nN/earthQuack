<?xml version="1.0" encoding="utf-8"?>
<!--
    SSH Terminal.
    Top: status row + connect/disconnect. Middle: scrollable terminal log.
    Bottom: control keys + a transparent Termux-style keyboard sink (no send
    button — keystrokes go straight to the shell and the PTY echoes them).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_terminal_background">

    <LinearLayout
        style="@style/Widget.Eq.Screen">

        <!-- Status + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@color/eq_terminal_background">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/eq_terminal_muted"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Disconnected"
                tools:text="Connected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                style="@style/Widget.Eq.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/terminal_connect"
                app:icon="@drawable/ic_eq_play"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDisconnect"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/terminal_disconnect"
                android:enabled="false"
                app:icon="@drawable/ic_eq_stop"
                app:iconSize="16dp" />
        </LinearLayout>

        <View style="@style/Widget.Eq.Divider" />

        <!-- Terminal log (scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/terminalScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:background="@color/eq_terminal_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/terminalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/eq_terminal_text"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.1"
                android:letterSpacing="0"
                tools:text="user@archii:~$ ls&#10;file1.txt  file2.txt  dir1/&#10;user@archii:~$ " />
        </androidx.core.widget.NestedScrollView>

        <View style="@style/Widget.Eq.Divider" />

        <!--
            Control keys. A soft keyboard has no Ctrl, so without these there
            is no way to send Ctrl+C to a shell that is waiting for it — the
            terminal looks connected and cannot interrupt anything.
        -->
        <HorizontalScrollView
            android:id="@+id/controlKeyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/eq_terminal_background">

            <LinearLayout
                android:id="@+id/controlKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <View style="@style/Widget.Eq.Divider" />

        <!--
            Keyboard sink (Termux-style).

            There is no visible text field and no send button: the terminal is a
            log of what the PTY echoes, so keystrokes are forwarded straight to
            the shell by TerminalInputView and the characters appear in the log
            because the remote echoes them. The field itself is fully
            transparent — tapping the terminal focuses it and opens the keyboard
            in a single tap (see TerminalFragment.focusInputAndShowKeyboard).
        -->
        <com.example.earthquack.ui.TerminalInputView
            android:id="@+id/inputField"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="0dp"
            android:background="@android:color/transparent"
            android:enabled="false"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="@android:color/transparent"
            android:textColorHighlight="@android:color/transparent"
            android:textCursorDrawable="@android:color/transparent"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions|textVisiblePassword"
            android:imeOptions="actionNone|flagNoExtractUi|flagNoFullscreen|flagNoPersonalizedLearning"
            android:privateImeOptions="nm"
            android:maxLines="1" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
