<?xml version="1.0" encoding="utf-8"?>
<!--
    One clipboard history entry.

    Direction is shown with a real label ("Sent to Desktop" / "Received from
    Desktop") rather than an arrow glyph alone, so the meaning survives
    translation and does not depend on recognising an icon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Eq.RowIcon">

    <ImageView
        android:id="@+id/historyIcon"
        android:layout_width="@dimen/eq_icon"
        android:layout_height="@dimen/eq_icon"
        android:src="@drawable/ic_eq_doc"
        app:tint="@color/eq_text_muted"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/eq_gap_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.RowTitle"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="sudo pacman -S tailscale" />

        <TextView
            android:id="@+id/historyMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.Meta"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Received from Desktop · 27 characters · 14:45" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/historyCopy"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="9dp"
        android:src="@drawable/ic_eq_copy"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/eq_text_muted"
        android:contentDescription="@string/action_copy" />

</LinearLayout>
