<?xml version="1.0" encoding="utf-8"?>
<!--
    Connection profiles: a simple list, each row opening the profile for
    editing or its terminal / files.

    No Compose: the rest of the app builds its screens the same way.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_gutter"
        android:paddingEnd="@dimen/eq_gutter"
        android:paddingTop="@dimen/eq_gap_sm"
        android:paddingBottom="@dimen/eq_gap_xl">

        <!-- How many profiles are configured. -->
        <include android:id="@+id/statusProfiles" layout="@layout/partial_status_row" />

        <!-- The list of profiles. -->
        <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- Empty state: no profiles yet. -->
        <LinearLayout
            android:id="@+id/emptyState"
            style="@style/Widget.Eq.Card"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_gap_md"
                android:gravity="center"
                android:text="@string/profiles_empty"
                android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
        </LinearLayout>

        <!-- Add a new profile. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Eq.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/eq_gap_sm"
            android:text="@string/profiles_add"
            app:icon="@drawable/ic_eq_add"
            app:iconSize="16dp" />

    </LinearLayout>
</ScrollView>
