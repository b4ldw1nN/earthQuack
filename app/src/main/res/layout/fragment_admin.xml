<?xml version="1.0" encoding="utf-8"?>
<!--
    Admin console.

    A thin client over the Tailscale admin API. The API key is the only
    secret here, so it is asked for once and kept in the keystore-backed
    secret store, not in plain preferences.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_gutter"
        android:paddingEnd="@dimen/eq_gutter"
        android:paddingTop="@dimen/eq_gap_sm"
        android:paddingBottom="@dimen/eq_gap_xl">

        <include
            android:id="@+id/statusBanner"
            layout="@layout/partial_status_banner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_api_key"
            android:textAppearance="@style/TextAppearance.Eq.Overline" />

        <EditText
            android:id="@+id/fieldApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_sm"
            android:background="@drawable/bg_eq_field"
            android:padding="@dimen/eq_gap_md"
            android:textColor="@color/eq_text_primary"
            android:textColorHint="@color/eq_text_muted"
            android:textSize="15sp"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:hint="@string/admin_api_key_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_md"
            android:text="@string/admin_device_id"
            android:textAppearance="@style/TextAppearance.Eq.Overline" />

        <EditText
            android:id="@+id/fieldDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_sm"
            android:background="@drawable/bg_eq_field"
            android:padding="@dimen/eq_gap_md"
            android:textColor="@color/eq_text_primary"
            android:textColorHint="@color/eq_text_muted"
            android:textSize="15sp"
            android:importantForAutofill="no"
            android:inputType="text"
            android:hint="@string/admin_device_id_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevices"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_devices" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDns"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/eq_gap_sm"
                android:text="@string/admin_dns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcl"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/eq_gap_sm"
                android:text="@string/admin_acl" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpire"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_expire_key" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/eq_gap_sm"
                android:text="@string/admin_delete_device" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_md"
            android:text="@string/admin_output"
            android:textAppearance="@style/TextAppearance.Eq.Overline" />

        <TextView
            android:id="@+id/textOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_sm"
            android:background="@drawable/bg_eq_field"
            android:padding="@dimen/eq_gap_md"
            android:textAppearance="@style/TextAppearance.Eq.Meta"
            android:textIsSelectable="true"
            tools:text="{}" />

    </LinearLayout>
</ScrollView>
