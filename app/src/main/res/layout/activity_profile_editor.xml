<?xml version="1.0" encoding="utf-8"?>
<!--
    Add or edit a connection profile.

    One record powers both Terminal and Files, so there is no separate SFTP
    section: the host, port, username and host key a shell uses are exactly the
    ones an SFTP connection uses.

    The password field writes to the Keystore-backed SecretStore and is never
    stored in the profile itself; the key picker references a key by alias for
    the same reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eq_background">

    <include android:id="@+id/appbar" layout="@layout/partial_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/eq_gutter"
            android:paddingEnd="@dimen/eq_gutter"
            android:paddingBottom="@dimen/eq_gap_xl">

            <!-- Identity -->
            <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_name"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <EditText
                    android:id="@+id/fieldName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:background="@drawable/bg_eq_field"
                    android:padding="@dimen/eq_gap_md"
                    android:textColor="@color/eq_text_primary"
                    android:textColorHint="@color/eq_text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:hint="@string/profile_name_hint" />

                <View style="@style/Widget.Eq.Divider.Inset" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_host"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <EditText
                    android:id="@+id/fieldHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:background="@drawable/bg_eq_field"
                    android:padding="@dimen/eq_gap_md"
                    android:textColor="@color/eq_text_primary"
                    android:textColorHint="@color/eq_text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:hint="@string/profile_host_hint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_port"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <EditText
                    android:id="@+id/fieldPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:background="@drawable/bg_eq_field"
                    android:padding="@dimen/eq_gap_md"
                    android:textColor="@color/eq_text_primary"
                    android:textColorHint="@color/eq_text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:hint="@string/profile_port_hint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_username"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <EditText
                    android:id="@+id/fieldUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:background="@drawable/bg_eq_field"
                    android:padding="@dimen/eq_gap_md"
                    android:textColor="@color/eq_text_primary"
                    android:textColorHint="@color/eq_text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:hint="@string/profile_username_hint" />
            </LinearLayout>

            <!-- Authentication -->
            <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_auth_header"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/authKeyRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/eq_touch_min"
                        android:text="@string/profile_auth_key"
                        android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                    <RadioButton
                        android:id="@+id/authPasswordRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/eq_touch_min"
                        android:text="@string/profile_auth_password"
                        android:textAppearance="@style/TextAppearance.Eq.RowTitle" />
                </RadioGroup>

                <!-- Key section: pick an existing key, generate one, or import. -->
                <LinearLayout
                    android:id="@+id/keySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/rowKeySelect"
                        style="@style/Widget.Eq.Row">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_key"
                                android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                            <TextView
                                android:id="@+id/textSelectedKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_key_none"
                                android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="@dimen/eq_gap_sm"
                            android:src="@drawable/ic_eq_chevron"
                            android:contentDescription="@null"
                            app:tint="@color/eq_text_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eq_gap_sm"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenerateKey"
                            style="@style/Widget.Eq.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/eq_gap_sm"
                            android:text="@string/profile_key_generate"
                            app:icon="@drawable/ic_eq_add" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportKey"
                            style="@style/Widget.Eq.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/profile_key_import"
                            app:icon="@drawable/ic_eq_attach" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Password section: writes straight to the SecretStore. -->
                <LinearLayout
                    android:id="@+id/passwordSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_password"
                        android:textAppearance="@style/TextAppearance.Eq.Overline" />

                    <EditText
                        android:id="@+id/fieldPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eq_gap_sm"
                        android:background="@drawable/bg_eq_field"
                        android:padding="@dimen/eq_gap_md"
                        android:textColor="@color/eq_text_primary"
                        android:textSize="15sp"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:hint="@string/profile_password_hint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eq_gap_xs"
                        android:text="@string/profile_password_note"
                        android:textAppearance="@style/TextAppearance.Eq.Hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- Host key -->
            <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_host_key"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <TextView
                    android:id="@+id/textHostKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_xs"
                    android:text="@string/profile_host_key_unverified"
                    android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Eq.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_gap_lg"
                android:text="@string/profile_save"
                app:icon="@drawable/ic_eq_check" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
