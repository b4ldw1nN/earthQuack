<?xml version="1.0" encoding="utf-8"?><!--
    Streams one remote video: ExoPlayer over the loopback range server.

    The three states are one FrameLayout rather than three screens, matching
    activity_file_preview.xml: loading, playing and failure are never visible
    at the same time, and the switching rule is "what does the player have to
    say right now".

    PlayerView is media3's own view, which brings the transport controls, the
    buffering spinner and the aspect-correct surface with it. That is the
    smallest surface that plays a remote file with seeking; writing a scrubber
    on a SurfaceView would be a rendering stack this app does not need.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background">

    <LinearLayout
        style="@style/Widget.Eq.Screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/eq_background">

            <include
                android:id="@+id/appbar"
                layout="@layout/partial_topbar"
                android:layout_width="0dp"
                android:layout_height="@dimen/eq_topbar_h"
                android:layout_weight="1" />

            <!--
                Streams the URL to an external media player (e.g. VLC, MPV)
                via the local loopback RangeHttpServer.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExternal"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/eq_gap_xs"
                android:text="@string/files_stream_external"
                app:icon="@drawable/ic_eq_open_new"
                app:iconSize="@dimen/eq_icon_sm"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
                Saves the whole file to Downloads instead of streaming it.
                The honest alternative to watching the first ten seconds of a
                2 GB film over a mobile connection.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/eq_gap_sm"
                android:text="@string/files_stream_download"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <View style="@style/Widget.Eq.Divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
                Before the first frame: the remote has not been read yet, or
                the buffer is still filling. Separate from the failure state
                because it is the same request one second later.
            -->
            <LinearLayout
                android:id="@+id/loadingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/eq_gutter"
                android:paddingEnd="@dimen/eq_gutter">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/eq_primary"
                    app:trackThickness="@dimen/eq_divider" />

                <TextView
                    android:id="@+id/loadingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_md"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
                    tools:text="@string/files_stream_connecting" />
            </LinearLayout>

            <!--
                A remote that cannot be read, a backend with no range support,
                or a player error. Always carries a way out: download the file
                instead, or go back.
            -->
            <LinearLayout
                android:id="@+id/stateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/eq_gutter"
                android:paddingEnd="@dimen/eq_gutter"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/stateIcon"
                    android:layout_width="@dimen/eq_icon_lg"
                    android:layout_height="@dimen/eq_icon_lg"
                    android:src="@drawable/ic_eq_warning"
                    app:tint="@color/eq_error"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/stateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_md"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
                    tools:text="@string/files_stream_failed" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Eq.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_md"
                    android:text="@string/action_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
