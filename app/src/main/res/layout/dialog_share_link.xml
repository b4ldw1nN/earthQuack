<?xml version="1.0" encoding="utf-8"?>
<!--
    Body of the "Link ready" dialog shown after a successful Share as link.

    The URL is the payload, so it is a selectable TextView (long-press to select
    is how a user copies a link when the button is not enough) inside a scroll, so
    a long drive.google.com URL is never clipped at a large font scale. Three
    explicit actions follow — copy, open, share — rather than assuming one of them
    is what the user wants.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/eq_gap_lg"
    android:paddingEnd="@dimen/eq_gap_lg"
    android:paddingTop="@dimen/eq_gap_md">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="160dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/linkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textAppearance="@style/TextAppearance.Eq.RowValue"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="https://drive.google.com/open?id=1AbCdEfGhIjKlMnOpQrStUv" />
    </ScrollView>

    <TextView
        android:id="@+id/linkWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eq_gap_sm"
        android:textAppearance="@style/TextAppearance.Eq.Meta"
        tools:text="@string/files_share_link_warning" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eq_gap_md"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLink"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_share_link_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenLink"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eq_gap_sm"
            android:text="@string/files_share_link_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLink"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eq_gap_sm"
            app:icon="@drawable/ic_eq_send"
            android:text="@string/files_share_link_share" />
    </LinearLayout>

</LinearLayout>
