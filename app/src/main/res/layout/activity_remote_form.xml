<?xml version="1.0" encoding="utf-8"?>
<!--
    Step 2: the per-backend settings form.

    The whole layout is generated at runtime from ProviderInfo.settings, because
    rclone backends take wildly different keys (an SFTP host/key, a Drive client
    id, a MEGA user). A hand-written form per backend is not maintainable across
    ~40 of them, and would inevitably disagree with config/providers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/eq_background">

    <include android:id="@+id/appbar" layout="@layout/partial_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/eq_gutter"
            android:paddingEnd="@dimen/eq_gutter"
            android:paddingBottom="@dimen/eq_gap_xl">

            <!-- Remote name is ours, not rclone's: it is the [section] name. -->
            <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_name"
                    android:textAppearance="@style/TextAppearance.Eq.Overline" />

                <EditText
                    android:id="@+id/editRemoteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:background="@drawable/bg_eq_field"
                    android:padding="@dimen/eq_gap_md"
                    android:textColor="@color/eq_text_primary"
                    android:textColorHint="@color/eq_text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:hint="@string/remote_name_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!--
                Shown only for backends whose OAuth flow cannot run here.
                nonInteractive=true stops rclone opening a browser, so a backend
                that needs authorisation would otherwise hang or fail obscurely.
            -->
            <LinearLayout
                android:id="@+id/cardOauthNote"
                style="@style/Widget.Eq.Card"
                android:layout_marginTop="@dimen/eq_gap_sm"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_oauth_title"
                    android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_xs"
                    android:text="@string/remote_oauth_body"
                    android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
            </LinearLayout>

            <TextView
                android:id="@+id/textFormError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_gap_md"
                android:textColor="@color/eq_error"
                android:textAppearance="@style/TextAppearance.Eq.Meta"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreate"
                style="@style/Widget.Eq.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_gap_md"
                android:text="@string/action_create_remote"
                app:icon="@drawable/ic_eq_add"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
