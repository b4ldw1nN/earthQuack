<?xml version="1.0" encoding="utf-8"?>
<!--
    Security.

    Encryption controls moved here from the old giant settings screen.

    Both secret fields are masked by default with an explicit reveal control.
    They are never written to logcat from this screen, and the warning at the
    bottom states plainly that this build stores them unencrypted — which is
    true, and better surfaced than quietly implied to be safe.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_gutter"
        android:paddingEnd="@dimen/eq_gutter"
        android:paddingTop="@dimen/eq_gap_sm"
        android:paddingBottom="@dimen/eq_gap_xl">

        <!-- Encryption toggle -->
        <LinearLayout style="@style/Widget.Eq.Card" android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/eq_icon"
                android:layout_height="@dimen/eq_icon"
                android:src="@drawable/ic_eq_lock"
                app:tint="@color/eq_success"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/eq_gap_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_encryption"
                    android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_encryption_sub"
                    android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEncryption"
                style="@style/Widget.Eq.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Authentication -->
        <LinearLayout style="@style/Widget.Eq.SectionHeader">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/security_auth_header"
                android:textAppearance="@style/TextAppearance.Eq.SectionHeader" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

            <!-- Bearer token -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_token"
                    android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm">

                    <EditText
                        android:id="@+id/editToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_eq_field"
                        android:padding="@dimen/eq_gap_md"
                        android:textColor="@color/eq_text_primary"
                        android:textColorHint="@color/eq_text_muted"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:importantForAutofill="no"
                        android:hint="@string/security_token_hint"
                        tools:ignore="LabelFor" />

                    <ImageButton
                        android:id="@+id/btnRevealToken"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:padding="12dp"
                        android:src="@drawable/ic_eq_eye"
                        android:background="@android:color/transparent"
                        app:tint="@color/eq_text_muted"
                        android:contentDescription="@string/action_show" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:text="@string/security_token_sub"
                    android:textAppearance="@style/TextAppearance.Eq.Meta" />
            </LinearLayout>

            <View style="@style/Widget.Eq.Divider"
                android:layout_marginTop="@dimen/eq_gap_md"
                android:layout_marginBottom="@dimen/eq_gap_md" />

            <!-- AES key -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_key"
                    android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm">

                    <EditText
                        android:id="@+id/editKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:background="@drawable/bg_eq_field"
                        android:padding="@dimen/eq_gap_md"
                        android:textColor="@color/eq_text_primary"
                        android:textColorHint="@color/eq_text_muted"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:importantForAutofill="no"
                        android:hint="@string/security_key_hint"
                        tools:ignore="LabelFor" />

                    <ImageButton
                        android:id="@+id/btnRevealKey"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:padding="12dp"
                        android:src="@drawable/ic_eq_eye"
                        android:background="@android:color/transparent"
                        app:tint="@color/eq_text_muted"
                        android:contentDescription="@string/action_show" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textKeyError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:textColor="@color/eq_error"
                    android:textAppearance="@style/TextAppearance.Eq.Meta"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Invalid key — must be 44 characters of Base64 (32 bytes)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eq_gap_sm"
                    android:text="@string/security_key_sub"
                    android:textAppearance="@style/TextAppearance.Eq.Meta" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_md"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                style="@style/Widget.Eq.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/eq_gap_sm"
                android:text="@string/security_generate"
                app:icon="@drawable/ic_eq_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyKey"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/security_copy_key"
                app:icon="@drawable/ic_eq_copy" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout style="@style/Widget.Eq.SectionHeader">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/security_status_header"
                android:textAppearance="@style/TextAppearance.Eq.SectionHeader" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardStatus"
            style="@style/Widget.Eq.Card"
            android:orientation="vertical" />

        <!-- Honest disclosure. This build really does store both values as
             plaintext in SharedPreferences; saying so is the whole reason this
             note exists rather than a generic reassurance. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_gap_md"
            android:text="@string/security_storage_warning"
            android:textAppearance="@style/TextAppearance.Eq.Hint" />

    </LinearLayout>
</ScrollView>
