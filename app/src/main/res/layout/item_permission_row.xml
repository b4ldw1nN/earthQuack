<?xml version="1.0" encoding="utf-8"?>
<!-- One permission: icon, name, consequence, state, and a Grant button that is
     hidden once granted rather than left greyed out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Eq.RowIcon">

    <ImageView
        android:id="@+id/permIcon"
        android:layout_width="@dimen/eq_icon"
        android:layout_height="@dimen/eq_icon"
        android:src="@drawable/ic_eq_shield"
        app:tint="@color/eq_text_secondary"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/eq_gap_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/permName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.RowTitle"
            tools:text="Notifications" />

        <TextView
            android:id="@+id/permWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
            tools:text="Required to run the clipboard sync in the foreground." />

        <TextView
            android:id="@+id/permState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Eq.Meta"
            tools:text="Not granted" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGrant"
        style="@style/Widget.Eq.Button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/permissions_grant" />

</LinearLayout>
