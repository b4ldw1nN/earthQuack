<?xml version="1.0" encoding="utf-8"?>
<!--
    Battery & Background.

    The two toggles are the existing ServerConfig-backed settings, moved off the
    old settings page. The battery-optimisation row is separate because it is
    not a setting the app controls — it is a system grant, and it is the most
    common reason a working sync stops after a while on aggressive OEM builds.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_gutter"
        android:paddingEnd="@dimen/eq_gutter"
        android:paddingTop="@dimen/eq_gap_sm"
        android:paddingBottom="@dimen/eq_gap_xl">

        <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">

            <LinearLayout style="@style/Widget.Eq.Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_keep_running"
                        android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_keep_running_sub"
                        android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBatterySaver"
                    style="@style/Widget.Eq.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Widget.Eq.Divider.Inset" />

            <LinearLayout style="@style/Widget.Eq.Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_pause_screen_off"
                        android:textAppearance="@style/TextAppearance.Eq.RowTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_pause_screen_off_sub"
                        android:textAppearance="@style/TextAppearance.Eq.RowSubtitle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPauseScreenOff"
                    style="@style/Widget.Eq.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Widget.Eq.SectionHeader">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/battery_optimisation_header"
                android:textAppearance="@style/TextAppearance.Eq.SectionHeader" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.Eq.Card" android:orientation="vertical">
            <TextView
                android:id="@+id/textOptimisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Eq.RowSubtitle"
                tools:text="Exempt — the service can run in the background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfigureOptimisation"
                style="@style/Widget.Eq.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_gap_md"
                android:text="@string/battery_configure" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
